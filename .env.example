# URL base del backend Express actual (fase puente).
# Cuando el backend se migre a Rust/Axum, este valor pasará a apuntar ahí.
PUBLIC_API_URL=http://localhost:3001

# En true, todas las llamadas de src/lib/api.ts se resuelven contra un backend en memoria
# con datos de ejemplo (src/lib/mock/), sin tocar el backend real ni ninguna base de datos.
# Sirve para recorrer las pantallas con contenido completo sin depender del backend/DB.
# Los datos NO persisten entre recargas de página. Ver README.md para las cuentas de prueba.
# true = modo standalone 100% en memoria, recomendado para la corrección (no requiere backend ni DB).
PUBLIC_MOCK_MODE=true
